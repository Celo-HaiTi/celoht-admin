# Supabase - create a project at https://supabase.com and paste your keys below
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set to "true" to force the dashboard into mock-data mode regardless of
# whether Supabase env vars are present. Useful for local design work.
NEXT_PUBLIC_FORCE_MOCK_DATA=false

# Development-only design review access. Never enable this in production.
NEXT_PUBLIC_ALLOW_UNAUTHENTICATED_MOCK_MODE=true

# GitHub Analytics dashboard (read-only, public repo stats)
GITHUB_TOKEN=
GITHUB_ORG=Celo-HaiTi

# Celo Blockchain Analytics dashboard
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CELO_NETWORK=mainnet

# Auth
NEXTAUTH_SECRET=
